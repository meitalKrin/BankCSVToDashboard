<?xml version="1.0" encoding="utf-8"?>
<!--
  Spike 0.1 — the notification collector.

  THERE IS DELIBERATELY NO android.permission.INTERNET HERE.

  This app reads every notification on the phone. It must be *provably*
  incapable of sending them anywhere, and that proof is this file: with no
  INTERNET permission the platform refuses every socket the process opens.
  Do not add it. If a future change appears to need it, that change does not
  belong in this spike.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app ask for the battery-optimisation exemption directly
         instead of only pointing at the settings list. No network implied. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Collector">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CollectorService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
